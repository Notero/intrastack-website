# Copy this file to .env.local and fill in real values.
# None of the values below are real — they are placeholders only.

# --- Supabase -----------------------------------------------------------
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Server-only — never expose to the browser. Used by admin/server actions
# and by the Playwright e2e global-setup/teardown to create/clean up test users.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Newer-style Supabase secret key, used by scripts/seed-news-extra-images.mjs.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# --- Email (Resend) ------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourcompany.com

# --- Rate limiting (Upstash Redis) ---------------------------------------
# Optional in dev — when unset, rate limiting is disabled (see src/lib/rateLimit.ts).
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# --- AI (resume parsing / matching) --------------------------------------
# Optional in dev — when unset, src/lib/resume/parse.ts and match.ts fall
# back to deterministic stubs instead of calling the Anthropic API.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Used by the chat widget's backend route (src/app/api/chat/chat/route.ts).
GROQ_API_KEY=your_groq_api_key_here

# --- Cron ------------------------------------------------------------
# Shared secret checked by src/lib/retention/cronAuth.ts to authorize the
# scheduled data-retention purge route (see vercel.json for the schedule).
CRON_SECRET=a_long_random_string_here

# --- Site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lighthouse audits (scripts/audit-lighthouse.mjs) --------------------
# BASE_URL=http://localhost:3000
# LIGHTHOUSE_MIN_SCORE=90

# --- Playwright e2e test accounts (tests/e2e/global-setup.ts) ------------
# These must correspond to real accounts seeded in your Supabase dev project.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=change_me
E2E_CUSTOMER_EMAIL=customer@example.com
E2E_CUSTOMER_PASSWORD=change_me
